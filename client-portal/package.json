{
  "name": "client-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080",
    "build": "npm run errors:check && npm run brand:check && npm run typecheck && npm run i18n:check && vite build --mode prod",
    "build:dev": "vite build --mode dev",
    "build:prod": "vite build --mode prod",
    "lint": "eslint . --ext ts,tsx",
    "preview": "vite preview",
    "start:dev": "env-cmd -f .env.development node index.js",
    "start:prod": "env-cmd -f .env.production node index.js",
    "typecheck": "tsc --noEmit",
    "i18n:extract": "node scripts/i18n-catalog.mjs --write",
    "i18n:check": "node scripts/i18n-catalog.mjs --check",
    "i18n:translate": "node scripts/libretranslate.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "errors:check": "node scripts/check-user-safe-errors.mjs",
    "brand:check": "node scripts/check-public-identity.mjs",
    "test:errors": "vitest run src/errors/userSafeError.test.ts src/compat/storageKeys.test.ts src/api/generated/beyvra.test.ts",
    "test:realtime": "vitest run src/realtime/UnifiedRealtimeClient.test.ts",
    "test": "npm run typecheck && npm run build:prod",
    "test:contract": "node scripts/check-api-contract.mjs",
    "test:e2e": "playwright test"
    ,"test:chart": "vitest run src/pages/private/platform/chart/chartEngine.test.ts src/pages/private/platform/chart/workspaceIntegration.test.ts src/pages/private/platform/chart/performance.test.ts src/pages/private/platform/chart/indicators/indicators.test.ts src/pages/private/platform/chart/drawings/drawings.test.ts src/pages/private/platform/chart/trades/tradeMarkers.test.ts src/pages/private/platform/chart/events/newsCalendar.test.ts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@reduxjs/toolkit": "2.12.0",
    "@segment/analytics-next": "^1.76.0",
    "@tanstack/react-query": "5.101.4",
    "@types/lodash": "^4.14.202",
    "antd": "^5.21.6",
    "antd-style": "^3.6.1",
    "dotenv": "^16.4.5",
    "echarts": "^6.1.0",
    "formik": "^2.4.5",
    "i18next": "^23.9.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^4.0.1",
    "jquery": "4.0.0",
    "lightweight-charts": "^4.2.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "react": "19.2.7",
    "react-cookie": "^7.1.0",
    "react-dom": "19.2.7",
    "react-hook-form": "7.84.0",
    "react-i18next": "^14.0.5",
    "react-insta-stories": "^2.6.2",
    "react-qr-code": "2.2.0",
    "react-redux": "9.3.0",
    "react-router": "7.18.2",
    "react-router-dom": "7.18.2",
    "react-select": "5.10.2",
    "react-slick": "0.31.0",
    "react-toastify": "^10.0.4",
    "react-ts-tradingview-widgets": "1.2.8",
    "react-verification-input": "4.2.2",
    "react-vertical-timeline-component": "4.0.0",
    "slick-carousel": "^1.8.1",
    "socket.io-client": "^4.8.3",
    "swiper": "^14.0.7",
    "void-elements": "^3.1.0",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.11.20",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/react-redux": "^7.1.33",
    "@types/react-slick": "^0.23.13",
    "@types/react-vertical-timeline-component": "^3.3.6",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "env-cmd": "^10.1.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.41",
    "sass": "^1.69.5",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.2.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
