COMPOSE_PROJECT_NAME=beyvra-frontend
PORT=8080
VITE_API_BASE_URL=/api
VITE_SOCKET_BASE_URL=AUTO
VITE_PUBLIC_SITE_URL=https://staging.beyvra.com
VITE_BRAND_NAME=Beyvra
VITE_GEOIP_ENDPOINT=
VITE_REALTIME_V2_ENABLED=true
VITE_REALTIME_V2_V1_FALLBACK_ENABLED=false
VITE_DEPLOYMENT_READ_ONLY=true

# This file contains public browser configuration only. Human authentication,
# provider credentials, signing keys, database credentials, and deployment
# credentials remain server-side and must never be added to VITE_* variables.
