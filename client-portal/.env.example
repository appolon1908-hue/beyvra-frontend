COMPOSE_PROJECT_NAME=fx_portal_frontend
COMPOSE_FILE=docker-compose.yaml
COMPOSE_HTTP_TIMEOUT=86400
SERVER_PORT=8080
VITE_API_BASE_URL=/api
VITE_SOCKET_BASE_URL=wss://staging.beyvra.com
VITE_PUBLIC_SITE_URL=https://staging.beyvra.com
VITE_BRAND_NAME=Beyvra

# Human authentication is server-configured. Do not add a Keycloak client secret
# or store identity-provider tokens in Vite/browser environment variables.
