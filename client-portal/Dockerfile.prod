ARG NODE_IMAGE=node:22-bookworm-slim
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.29-alpine

FROM ${NODE_IMAGE} AS build-stage
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL=/api
ARG VITE_SOCKET_BASE_URL=AUTO
ARG VITE_PUBLIC_SITE_URL=https://beyvra.com
ARG VITE_BRAND_NAME=Beyvra
ARG VITE_GEOIP_ENDPOINT=
ARG VITE_REALTIME_V2_ENABLED=true
ARG VITE_REALTIME_V2_V1_FALLBACK_ENABLED=false
ARG VITE_DEPLOYMENT_READ_ONLY=true

RUN VITE_API_BASE_URL="$VITE_API_BASE_URL" \
    VITE_SOCKET_BASE_URL="$VITE_SOCKET_BASE_URL" \
    VITE_PUBLIC_SITE_URL="$VITE_PUBLIC_SITE_URL" \
    VITE_BRAND_NAME="$VITE_BRAND_NAME" \
    VITE_GEOIP_ENDPOINT="$VITE_GEOIP_ENDPOINT" \
    VITE_REALTIME_V2_ENABLED="$VITE_REALTIME_V2_ENABLED" \
    VITE_REALTIME_V2_V1_FALLBACK_ENABLED="$VITE_REALTIME_V2_V1_FALLBACK_ENABLED" \
    VITE_DEPLOYMENT_READ_ONLY="$VITE_DEPLOYMENT_READ_ONLY" \
    npm run build

FROM ${NGINX_IMAGE} AS production-stage

ARG VCS_REF=unknown
ARG BUILD_VERSION=unreleased
ARG BUILD_DATE=unknown

USER root

RUN apk upgrade --no-cache \
    && rm -f /etc/nginx/conf.d/default.conf \
    && mkdir -p /etc/nginx/templates \
    && chown -R nginx:nginx /etc/nginx/conf.d /etc/nginx/templates

COPY --chown=root:root nginx.conf /etc/nginx/nginx.conf
COPY --chown=root:root nginx-default.conf /etc/nginx/templates/default.conf.template
COPY --chown=root:root entrypoint.sh /usr/local/bin/beyvra-entrypoint
COPY --from=build-stage --chown=root:root /app/dist /usr/share/nginx/html

RUN chmod 0755 /usr/local/bin/beyvra-entrypoint \
    && find /usr/share/nginx/html -type d -exec chmod 0755 '{}' + \
    && find /usr/share/nginx/html -type f -exec chmod 0644 '{}' +

ENV VITE_API_BASE_URL=/api \
    VITE_SOCKET_BASE_URL=AUTO \
    VITE_PUBLIC_SITE_URL=https://beyvra.com \
    VITE_BRAND_NAME=Beyvra \
    VITE_GEOIP_ENDPOINT="" \
    VITE_REALTIME_V2_ENABLED=true \
    VITE_REALTIME_V2_V1_FALLBACK_ENABLED=false \
    VITE_DEPLOYMENT_READ_ONLY=true \
    BEYVRA_SOURCE_SHA=unknown \
    BEYVRA_IMAGE_DIGEST=unknown \
    BEYVRA_RELEASE_ID=unreleased \
    BEYVRA_BUILD_TIMESTAMP=unknown \
    PUBLIC_SERVER_NAME=beyvra.com \
    BACKEND_UPSTREAM=backend-nginx:8080

LABEL org.opencontainers.image.source="https://github.com/appolon1908-hue/beyvra-frontend" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.version="$BUILD_VERSION" \
      org.opencontainers.image.created="$BUILD_DATE" \
      org.opencontainers.image.title="Beyvra frontend" \
      org.opencontainers.image.description="Immutable same-origin Beyvra read-only web client"

EXPOSE 8080

USER 101

ENTRYPOINT ["/usr/local/bin/beyvra-entrypoint"]
CMD ["nginx", "-g", "daemon off;"]
