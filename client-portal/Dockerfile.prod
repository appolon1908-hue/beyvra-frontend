FROM node:22-bookworm-slim AS build-stage
WORKDIR /app
COPY package*.json /app/
RUN npm ci
COPY . .

ARG VITE_API_BASE_URL
ARG VITE_SOCKET_BASE_URL
ARG VITE_GEOIP_ENDPOINT

RUN VITE_API_BASE_URL=$VITE_API_BASE_URL \
 VITE_SOCKET_BASE_URL=$VITE_SOCKET_BASE_URL \
 VITE_GEOIP_ENDPOINT=$VITE_GEOIP_ENDPOINT \
 npm run build

FROM nginx:1.27.4-alpine AS production-stage
COPY nginx-default.conf /etc/nginx/conf.d/default.conf
COPY --from=build-stage /app/dist /usr/share/nginx/html
COPY config.js.template /etc/nginx/templates/config.js.template
ENV NGINX_ENVSUBST_OUTPUT_DIR=/usr/share/nginx/html
RUN chgrp -R 0 /usr/share/nginx/html && \
    chmod -R g=u /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
