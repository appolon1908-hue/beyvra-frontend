ARG NODE_IMAGE=node:22-bookworm-slim
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine

FROM ${NODE_IMAGE} AS build-stage
WORKDIR /app

ENV CI=true \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false

COPY package.json package-lock.json ./
RUN npm ci
COPY . .

ARG VITE_API_BASE_URL=/api
ARG VITE_SOCKET_BASE_URL=AUTO
ARG VITE_PUBLIC_SITE_URL
ARG VITE_BRAND_NAME=Beyvra
ARG VITE_GEOIP_ENDPOINT
ARG VITE_REALTIME_V2_ENABLED=false
ARG VITE_REALTIME_V2_V1_FALLBACK_ENABLED=false

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_SOCKET_BASE_URL=${VITE_SOCKET_BASE_URL} \
    VITE_PUBLIC_SITE_URL=${VITE_PUBLIC_SITE_URL} \
    VITE_BRAND_NAME=${VITE_BRAND_NAME} \
    VITE_GEOIP_ENDPOINT=${VITE_GEOIP_ENDPOINT} \
    VITE_REALTIME_V2_ENABLED=${VITE_REALTIME_V2_ENABLED} \
    VITE_REALTIME_V2_V1_FALLBACK_ENABLED=${VITE_REALTIME_V2_V1_FALLBACK_ENABLED}

# The authoritative production build includes the repository safety checks
# (error safety, public identity, typecheck, i18n) before Vite emits assets.
RUN npm run build

FROM ${NGINX_IMAGE} AS production-stage

ARG VCS_REF=unknown
ARG BUILD_VERSION=unreleased
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.source="https://github.com/appolon1908-hue/beyvra-frontend" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${BUILD_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="Beyvra Frontend" \
      org.opencontainers.image.description="Production Beyvra browser application"

COPY --chown=101:101 nginx-default.conf /etc/nginx/conf.d/default.conf
COPY --chown=101:101 --from=build-stage /app/dist /usr/share/nginx/html
COPY --chown=101:101 config.js.template /etc/nginx/templates/config.js.template

# Runtime config.js contains public configuration only. The unprivileged nginx
# entrypoint renders it on startup; secrets must never be supplied as VITE_* values.
ENV NGINX_ENVSUBST_OUTPUT_DIR=/usr/share/nginx/html

USER 101:101
EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
